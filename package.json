{
  "name": "@operator/projectkit",
  "version": "0.9.3",
  "description": "Standalone project-signal interface: the project-facing capture/event contract, a sink-agnostic emitter SDK, and the context-handoff protocol. Turns any repo into a testbed that emits work for an agent fleet. Imports NOTHING from control-plane or mesh \u2014 mesh is just one optional sink.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "handoff": "bin/handoff.mjs",
    "local-executor": "bin/local-executor.mjs",
    "pull-executor": "bin/pull-executor.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./dispatch": {
      "types": "./dist/dispatch.d.ts",
      "import": "./dist/dispatch.js"
    },
    "./worklifecycle": {
      "types": "./dist/worklifecycle.d.ts",
      "import": "./dist/worklifecycle.js"
    },
    "./mesh-hmac": {
      "types": "./dist/mesh-hmac.d.ts",
      "import": "./dist/mesh-hmac.js"
    },
    "./git-ref-sink": {
      "types": "./dist/git-ref-sink.d.ts",
      "import": "./dist/git-ref-sink.js"
    },
    "./artifact-sink": {
      "types": "./dist/artifact-sink.d.ts",
      "import": "./dist/artifact-sink.js"
    },
    "./handoff": {
      "types": "./dist/handoff.d.ts",
      "import": "./dist/handoff.js"
    },
    "./schemas/project-event.schema.json": "./schemas/project-event.schema.json",
    "./schemas/work-request.schema.json": "./schemas/work-request.schema.json",
    "./schemas/log-record.schema.json": "./schemas/log-record.schema.json",
    "./schemas/capture-envelope.schema.json": "./schemas/capture-envelope.schema.json",
    "./schemas/concern.schema.json": "./schemas/concern.schema.json",
    "./schemas/callback.schema.json": "./schemas/callback.schema.json",
    "./schemas/handoff.schema.json": "./schemas/handoff.schema.json"
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "bin",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/taylor_sando/projectkit.git"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
